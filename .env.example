# =====================================================================
# Configuración del Bot Meshtastic LoRa + AI v3.0
# =====================================================================

# Dirección IP del nodo Meshtastic (conexión TCP)
MESHTASTIC_HOST=192.168.68.68

# Puerto Serial alternativo (dejar vacío si se usa TCP, ej: /dev/ttyUSB0)
MESHTASTIC_PORT=

# Canal LoRa objetivo a monitorear
MESHTASTIC_CHANNEL=PlayaRica

# Motor LLM (Hailo-Ollama local en Raspberry Pi 5 con NPU Hailo-10H)
OLLAMA_URL=http://localhost:8000/api/generate
OLLAMA_MODEL=qwen2.5:1.5b

# Ubicación por defecto para consulta meteorológica
DEFAULT_LOCATION=San Roque Playa Rica

# Tiempo de enfriamiento (cooldown) anti-spam entre respuestas en segundos
COOLDOWN_SECONDS=5

# Límite máximo de caracteres por respuesta antes de truncar o multiparte
MAX_CHARS=620

# Máximo de partes permitidas (3 para pronóstico extendido [1/3], [2/3] y lectura rural [3/3])
MAX_PARTS=3

# Servidor HTTP FastAPI integrado (/health, /nodes, /messages, /simulate, /send)
API_HOST=0.0.0.0
API_PORT=8002

# Tiempo de vida del caché meteorológico y lectura LLM en segundos (900 = 15 min)
WEATHER_CACHE_TTL=900

# Zona horaria del contenedor
TZ=America/Bogota
